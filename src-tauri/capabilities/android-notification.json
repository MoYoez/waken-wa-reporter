{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "android-notification",
  "description": "Android-only persistent notification access for realtime reporter controls",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "notification:default",
    "waken-android-activity:allow-start-foreground-service",
    "waken-android-activity:allow-stop-foreground-service",
    "waken-android-activity:allow-register-listener"
  ]
}
